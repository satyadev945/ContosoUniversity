@model IEnumerable<ContosoUniversity.Application.DTOs.CourseDto>

@{
    ViewBag.Title = "Courses";
}

<h2>Courses</h2>
<br />
<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<br />
<table class="table">
    <tr>
        <th>@Html.DisplayNameFor(model => model.First().CourseID)</th>
        <th>@Html.DisplayNameFor(model => model.First().Title)</th>
        <th>@Html.DisplayNameFor(model => model.First().Credits)</th>
        <th>Department</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.CourseID)</td>
            <td>@Html.DisplayFor(modelItem => item.Title)</td>
            <td>@Html.DisplayFor(modelItem => item.Credits)</td>
            <td>@Html.DisplayFor(modelItem => item.DepartmentName)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CourseID" class="btn btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.CourseID" class="btn btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.CourseID" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }
</table>
