@model ContosoUniversity.Application.DTOs.StudentDto

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>

<!-- Tag Helper form replaces Html.BeginForm() -->
<form asp-action="Create">
    <!-- asp-validation-summary replaces Html.ValidationSummary -->
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-horizontal">
        <h4>Student</h4>
        <hr />
        <div class="form-group">
            <!-- asp-for Tag Helper replaces Html.LabelFor -->
            <label asp-for="LastName" class="control-label col-md-2"></label>
            <div class="col-md-10">
                <!-- asp-for on input replaces Html.EditorFor -->
                <input asp-for="LastName" class="form-control" />
                <!-- asp-validation-for replaces Html.ValidationMessageFor -->
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="FirstMidName" class="control-label col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="FirstMidName" class="form-control" />
                <span asp-validation-for="FirstMidName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="EnrollmentDate" class="control-label col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="EnrollmentDate" class="form-control" />
                <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
